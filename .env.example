# Prism SMM Panel - Environment Configuration
# Copy this file to .env and update values

# Application
APP_NAME="Prism SMM Panel"
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_KEY=change_this_to_random_64_char_string_here_abc123def456ghi789

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prism_smm
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=7200
SESSION_NAME=prism_session

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@prismsmm.com
MAIL_FROM_NAME="Prism SMM Panel"

# Payment Gateways
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

COINBASE_API_KEY=
COINBASE_WEBHOOK_SECRET=

# Default Currency
CURRENCY=USD
CURRENCY_SYMBOL=$

# OTP
OTP_EXPIRY=300
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# File Uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# Timezone
TIMEZONE=UTC
